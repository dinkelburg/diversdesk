OPENAI_API_KEY=
AI_SEARCH_SAFETY_SALT=
# Optional model override for evaluation. Defaults to gpt-5.6-terra.
AI_SEARCH_MODEL=

# Base origin hosting the TanStack signup iframe, without a trailing path.
TANSTACK_APP_ORIGIN=https://app.diversdesk.com

# Server-only credentials for native reCAPTCHA Enterprise assessments.
# Use a dedicated API key restricted to recaptchaenterprise.googleapis.com.
# The Astro dev server bypasses reCAPTCHA only on a loopback hostname.
GOOGLE_RECAPTCHA_PROJECT_ID=
GOOGLE_RECAPTCHA_API_KEY=
