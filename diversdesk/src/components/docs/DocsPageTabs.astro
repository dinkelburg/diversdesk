---
type TabItem = {
  href: string;
  label: string;
};

interface Props {
  items: TabItem[];
}

const { items } = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<nav class="docs-page-tabs" aria-label="Page sections">
  {items.map((item) => {
    const targetPath = item.href.replace(/\/$/, '') || '/';
    const isCurrent = targetPath === currentPath;

    return (
      <a
        href={item.href}
        class="docs-page-tabs__link"
        aria-current={isCurrent ? 'page' : undefined}
      >
        {item.label}
      </a>
    );
  })}
</nav>