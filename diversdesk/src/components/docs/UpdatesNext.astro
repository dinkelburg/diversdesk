<div class="updates-list" role="list">
  <div role="listitem">
    <button
      class="updates-card updates-card-next updates-card-next-button"
      type="button"
      aria-expanded="false"
      aria-controls="updates-coming-soon-note"
      data-updates-soon-toggle
    >
      <div class="updates-card-main">
        <p class="updates-card-line">Coming Soon · New Planner</p>
        <p class="updates-card-desc">A faster planning flow with clearer day-overviews and smoother drag-and-drop scheduling.</p>
      </div>
      <span class="updates-card-next-tag" aria-hidden="true">Soon</span>
    </button>

    <p class="updates-next-note" id="updates-coming-soon-note" hidden>
      Information for this update will be published soon.
    </p>
  </div>

  <a class="updates-card updates-card-next" href="/updates/2026-07-02-discount-calculator/" role="listitem">
    <div class="updates-card-main">
      <p class="updates-card-line">In Progress · More Discount Flexibility</p>
      <p class="updates-card-desc">We're currently working on making it easier to set and apply discounts.</p>
    </div>
    <span class="updates-card-next-tag" aria-hidden="true">Soon</span>
  </a>
</div>

<script is:inline>
  const initializeUpdatesSoonToggle = () => {
    document.querySelectorAll('[data-updates-soon-toggle]').forEach((toggle) => {
      if (!(toggle instanceof HTMLButtonElement)) {
        return;
      }

      const noteId = toggle.getAttribute('aria-controls');
      if (!noteId) {
        return;
      }

      const note = document.getElementById(noteId);
      if (!(note instanceof HTMLElement)) {
        return;
      }

      toggle.onclick = () => {
        const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
        const nextExpanded = !isExpanded;

        toggle.setAttribute('aria-expanded', String(nextExpanded));
        note.hidden = !nextExpanded;
      };
    });
  };

  document.addEventListener('astro:page-load', initializeUpdatesSoonToggle);
  document.addEventListener('astro:after-swap', initializeUpdatesSoonToggle);
  initializeUpdatesSoonToggle();
</script>