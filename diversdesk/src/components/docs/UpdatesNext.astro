<div class="updates-list" role="list">
  <div role="listitem">
    <button
      class="updates-card updates-card-next updates-card-next-button"
      type="button"
      aria-expanded="false"
      aria-controls="updates-in-progress-note"
      data-updates-soon-toggle
    >
      <div class="updates-card-main">
        <p class="updates-card-line">Requires Activation · Participant Panel</p>
        <p class="updates-card-desc">Review participant details, registration progress and documents in one panel. Available where the new participant panel is enabled.</p>
      </div>
      <span class="updates-card-next-tag" aria-hidden="true">Requires Activation</span>
    </button>

    <p class="updates-next-note" id="updates-in-progress-note" hidden>
      The new participant panel is disabled by default and enabled separately for each establishment. Contact the Diversdesk team to discuss availability.
    </p>
  </div>

  <div role="listitem">
    <button
      class="updates-card updates-card-next updates-card-next-button"
      type="button"
      aria-expanded="false"
      aria-controls="updates-coming-soon-note"
      data-updates-soon-toggle
    >
      <div class="updates-card-main">
        <p class="updates-card-line">Requires Activation · Rental Gear Fitting</p>
        <p class="updates-card-desc">Prepare gear by category, review sizes and assignments, and keep staff notes separate from customer answers. Available where New gear fitting is enabled.</p>
      </div>
      <span class="updates-card-next-tag" aria-hidden="true">Requires Activation</span>
    </button>

    <p class="updates-next-note" id="updates-coming-soon-note" hidden>
      New gear fitting is disabled by default. It can be used through the gear manifest views when enabled; using it inside the new participant panel requires that panel to be enabled as well.
    </p>
  </div>
</div>

<script is:inline>
  const initializeUpdatesSoonToggle = () => {
    document.querySelectorAll('[data-updates-soon-toggle]').forEach((toggle) => {
      if (!(toggle instanceof HTMLButtonElement)) {
        return;
      }

      const noteId = toggle.getAttribute('aria-controls');
      if (!noteId) {
        return;
      }

      const note = document.getElementById(noteId);
      if (!(note instanceof HTMLElement)) {
        return;
      }

      toggle.onclick = () => {
        const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
        const nextExpanded = !isExpanded;

        toggle.setAttribute('aria-expanded', String(nextExpanded));
        note.hidden = !nextExpanded;
      };
    });
  };

  document.addEventListener('astro:page-load', initializeUpdatesSoonToggle);
  document.addEventListener('astro:after-swap', initializeUpdatesSoonToggle);
  initializeUpdatesSoonToggle();
</script>