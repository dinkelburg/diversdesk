<div class="updates-list" role="list">
  <div role="listitem">
    <button
      class="updates-card updates-card-next updates-card-next-button"
      type="button"
      aria-expanded="false"
      aria-controls="updates-in-progress-note"
      data-updates-soon-toggle
    >
      <div class="updates-card-main">
        <p class="updates-card-line">Coming Next · Participant Panel</p>
        <p class="updates-card-desc">A single panel for participant details, registration progress and documents is planned for the next release update.</p>
      </div>
      <span class="updates-card-next-tag" aria-hidden="true">Coming Next</span>
    </button>

    <p class="updates-next-note" id="updates-in-progress-note" hidden>
      Release timing and availability will be shared in the next update.
    </p>
  </div>

  <div role="listitem">
    <button
      class="updates-card updates-card-next updates-card-next-button"
      type="button"
      aria-expanded="false"
      aria-controls="updates-coming-soon-note"
      data-updates-soon-toggle
    >
      <div class="updates-card-main">
        <p class="updates-card-line">Coming Next · Rental Gear Fitting</p>
        <p class="updates-card-desc">Category-based gear preparation, fitting details and assignment review are planned for the next release update.</p>
      </div>
      <span class="updates-card-next-tag" aria-hidden="true">Coming Next</span>
    </button>

    <p class="updates-next-note" id="updates-coming-soon-note" hidden>
      Release timing and availability will be shared in the next update.
    </p>
  </div>
</div>

<script is:inline>
  const initializeUpdatesSoonToggle = () => {
    document.querySelectorAll('[data-updates-soon-toggle]').forEach((toggle) => {
      if (!(toggle instanceof HTMLButtonElement)) {
        return;
      }

      const noteId = toggle.getAttribute('aria-controls');
      if (!noteId) {
        return;
      }

      const note = document.getElementById(noteId);
      if (!(note instanceof HTMLElement)) {
        return;
      }

      toggle.onclick = () => {
        const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
        const nextExpanded = !isExpanded;

        toggle.setAttribute('aria-expanded', String(nextExpanded));
        note.hidden = !nextExpanded;
      };
    });
  };

  document.addEventListener('astro:page-load', initializeUpdatesSoonToggle);
  document.addEventListener('astro:after-swap', initializeUpdatesSoonToggle);
  initializeUpdatesSoonToggle();
</script>