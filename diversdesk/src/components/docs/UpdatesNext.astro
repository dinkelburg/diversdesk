<div class="updates-list" role="list">
  <div role="listitem">
    <button
      class="updates-card updates-card-next updates-card-next-button"
      type="button"
      aria-expanded="false"
      aria-controls="updates-in-progress-note"
      data-updates-soon-toggle
    >
      <div class="updates-card-main">
        <p class="updates-card-line">In Progress · Planner Iteration</p>
        <p class="updates-card-desc">We are currently refining the planner with a faster planning flow, clearer day overviews, and smoother scheduling interactions.</p>
      </div>
      <span class="updates-card-next-tag" aria-hidden="true">In Progress</span>
    </button>

    <p class="updates-next-note" id="updates-in-progress-note" hidden>
      Work on this update is actively underway. More information will be published once the next milestone is ready.
    </p>
  </div>

  <div role="listitem">
    <button
      class="updates-card updates-card-next updates-card-next-button"
      type="button"
      aria-expanded="false"
      aria-controls="updates-coming-soon-note"
      data-updates-soon-toggle
    >
      <div class="updates-card-main">
        <p class="updates-card-line">Coming Soon · Rental Gear Module Iteration</p>
        <p class="updates-card-desc">The next roadmap item after planner work will focus on the next iteration of the rental gear module.</p>
      </div>
      <span class="updates-card-next-tag" aria-hidden="true">Soon</span>
    </button>

    <p class="updates-next-note" id="updates-coming-soon-note" hidden>
      Information for this update will be published soon.
    </p>
  </div>
</div>

<script is:inline>
  const initializeUpdatesSoonToggle = () => {
    document.querySelectorAll('[data-updates-soon-toggle]').forEach((toggle) => {
      if (!(toggle instanceof HTMLButtonElement)) {
        return;
      }

      const noteId = toggle.getAttribute('aria-controls');
      if (!noteId) {
        return;
      }

      const note = document.getElementById(noteId);
      if (!(note instanceof HTMLElement)) {
        return;
      }

      toggle.onclick = () => {
        const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
        const nextExpanded = !isExpanded;

        toggle.setAttribute('aria-expanded', String(nextExpanded));
        note.hidden = !nextExpanded;
      };
    });
  };

  document.addEventListener('astro:page-load', initializeUpdatesSoonToggle);
  document.addEventListener('astro:after-swap', initializeUpdatesSoonToggle);
  initializeUpdatesSoonToggle();
</script>