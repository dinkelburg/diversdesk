---
const solutionLinks = [
  { title: "Dive Centers", url: "/new/solutions/dive-centers" },
  { title: "Dive Resorts", url: "/new/solutions/dive-resorts" },
  { title: "Liveaboards", url: "/new/solutions/liveaboards" },
];

const featureLinks = [
  { title: "Digital onboarding", url: "/new/features/digital-onboarding" },
  { title: "Planner and scheduling", url: "/new/features/planner-scheduling" },
  { title: "Booking engine", url: "/new/features/booking-engine-channel-manager" },
  { title: "Accommodation module", url: "/new/features/accommodation-channel-manager" },
];
---

<footer class="landing-section pb-10 pt-6 lg:pb-14">
  <div class="landing-shell">
    <div class="landing-panel rounded-[32px] px-6 py-8 sm:px-8 lg:px-10 lg:py-10">
      <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr_0.9fr]">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-orange-700">DiversDesk Preview</p>
          <h2 class="landing-display mt-4 text-4xl text-slate-950">Clean, tailored landing pages without touching the live homepage yet.</h2>
          <p class="mt-4 max-w-xl text-base leading-7 text-slate-600">
            This preview route is where the new homepage, solution pages, and image-led layouts can evolve in parallel before anything replaces the live landing page.
          </p>
        </div>
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Solutions</p>
          <div class="mt-4 space-y-3">
            {solutionLinks.map((link) => (
              <a class="block text-base font-medium text-slate-800 transition hover:text-orange-700" href={link.url}>{link.title}</a>
            ))}
          </div>
        </div>
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Featured pages</p>
          <div class="mt-4 space-y-3">
            {featureLinks.map((link) => (
              <a class="block text-base font-medium text-slate-800 transition hover:text-orange-700" href={link.url}>{link.title}</a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>