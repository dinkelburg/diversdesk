---
import BrandLogo from "@components/BrandLogo.astro";

const solutionLinks = [
  {
    title: "Dive Centers",
    description: "Onboarding, planning, rentals, retail, wages, and finance workflows.",
    url: "/new/solutions/dive-centers",
  },
  {
    title: "Dive Resorts",
    description: "Accommodation, channel management, groups, split billing, and guest operations.",
    url: "/new/solutions/dive-resorts",
  },
  {
    title: "Liveaboards",
    description: "Cabins, manifests, agents, pre-arrival guest prep, and onboard commercial flow.",
    url: "/new/solutions/liveaboards",
  },
];

const pagePath = Astro.url.pathname;
const isSolutionsRoute = pagePath.startsWith("/new/solutions/");
---

<header class="preview-nav-wrap sticky top-0 z-[60] px-4 pt-4 sm:px-6 lg:px-8">
  <nav class="preview-nav landing-panel mx-auto flex w-full max-w-[1520px] items-center justify-between rounded-[28px] px-4 py-3 sm:px-6 lg:px-8" aria-label="Preview navigation">
    <a class="flex items-center gap-3 rounded-full px-1 py-1" href="/new" aria-label="DiversDesk preview homepage">
      <BrandLogo class="h-auto w-28" />
      <span class="hidden rounded-full bg-orange-50 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.16em] text-orange-700 sm:inline-flex">
        Preview
      </span>
    </a>

    <div class="hidden items-center gap-3 lg:flex">
      <details class="preview-dropdown group relative">
        <summary class={`preview-nav-link list-none ${isSolutionsRoute ? "preview-nav-link-active" : ""}`}>
          <span>Solutions</span>
          <svg class="h-4 w-4 text-slate-500 transition group-open:rotate-180" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="m5 8 5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </summary>
        <div class="preview-dropdown-panel absolute left-1/2 top-[calc(100%+1rem)] w-[720px] -translate-x-1/2 rounded-[28px] border border-slate-200 bg-white p-4 shadow-[0_24px_60px_rgba(15,23,42,0.14)]">
          <div class="grid gap-3 md:grid-cols-3">
            {solutionLinks.map((link) => (
              <a class="rounded-[22px] border border-slate-200 bg-slate-50 p-4 transition hover:border-orange-200 hover:bg-orange-50" href={link.url}>
                <p class="text-sm font-semibold uppercase tracking-[0.16em] text-orange-700">Solution</p>
                <h2 class="landing-display mt-3 text-2xl text-slate-950">{link.title}</h2>
                <p class="mt-3 text-sm leading-6 text-slate-600">{link.description}</p>
              </a>
            ))}
          </div>
        </div>
      </details>

      <a class={`preview-nav-link ${pagePath === "/new/features" || pagePath.startsWith("/new/features/") ? "preview-nav-link-active" : ""}`} href="/new/features">
        Features
      </a>
      <a class="preview-nav-link" href="/pricing">
        Pricing
      </a>
      <a class="preview-nav-link" href="/about">
        About
      </a>
      <a class="preview-nav-link" href="/contact">
        Contact
      </a>
    </div>

    <div class="hidden items-center gap-3 lg:flex">
      <a class="preview-nav-link" href="/signup2-trial">Start free trial</a>
      <a class="landing-button-primary" href="https://calendly.com/diversdesk-info/demo">Book a demo</a>
    </div>

    <details class="preview-mobile-menu relative lg:hidden">
      <summary class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-slate-200 bg-white text-slate-900 list-none">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
      </summary>
      <div class="landing-panel absolute right-0 top-[calc(100%+1rem)] w-[min(24rem,calc(100vw-2rem))] rounded-[28px] p-4 shadow-[0_24px_60px_rgba(15,23,42,0.14)]">
        <div class="space-y-4">
          <div>
            <p class="px-3 text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Solutions</p>
            <div class="mt-2 space-y-2">
              {solutionLinks.map((link) => (
                <a class="block rounded-[20px] border border-slate-200 bg-slate-50 px-4 py-3" href={link.url}>
                  <span class="block text-base font-semibold text-slate-950">{link.title}</span>
                  <span class="mt-1 block text-sm leading-6 text-slate-600">{link.description}</span>
                </a>
              ))}
            </div>
          </div>
          <div class="landing-divider"></div>
          <div class="space-y-2">
            <a class="block rounded-full px-3 py-2 text-sm font-semibold text-slate-800" href="/new/features">Features</a>
            <a class="block rounded-full px-3 py-2 text-sm font-semibold text-slate-800" href="/pricing">Pricing</a>
            <a class="block rounded-full px-3 py-2 text-sm font-semibold text-slate-800" href="/about">About</a>
            <a class="block rounded-full px-3 py-2 text-sm font-semibold text-slate-800" href="/contact">Contact</a>
          </div>
          <div class="flex flex-col gap-3 pt-2">
            <a class="landing-button-secondary" href="/signup2-trial">Start free trial</a>
            <a class="landing-button-primary" href="https://calendly.com/diversdesk-info/demo">Book a demo</a>
          </div>
        </div>
      </div>
    </details>
  </nav>
</header>