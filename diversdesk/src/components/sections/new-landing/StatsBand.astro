---
interface StatItem {
  value: number;
  prefix?: string;
  suffix?: string;
  label: string;
  detail: string;
}

interface Props {
  title?: string;
  intro?: string;
  stats: StatItem[];
}

const { title, intro, stats }: Props = Astro.props;
---

<section class="landing-section py-8 lg:py-12">
  <div class="landing-shell">
    <div class="landing-card rounded-[32px] px-6 py-8 sm:px-8 lg:px-10 lg:py-10" data-countup-group>
      {
        (title || intro) && (
          <div class="mb-8 max-w-3xl">
            {title && <h2 class="landing-display text-3xl text-slate-950 sm:text-4xl">{title}</h2>}
            {intro && <p class="mt-3 text-base leading-7 text-slate-600">{intro}</p>}
          </div>
        )
      }
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        {stats.map((stat) => (
          <div class="rounded-[24px] border border-slate-200/70 bg-white/80 p-5">
            <p class="landing-stat-value text-5xl font-semibold text-slate-950 sm:text-6xl">
              <span>{stat.prefix || ""}</span><span data-countup-target={stat.value} data-countup-suffix={stat.suffix || ""}>0</span>
            </p>
            <h3 class="mt-4 text-lg font-semibold text-slate-900">{stat.label}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">{stat.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const countupGroups = document.querySelectorAll("[data-countup-group]");

  countupGroups.forEach((group) => {
    if (group.dataset.countupBound === "true") return;
    group.dataset.countupBound = "true";

    const values = group.querySelectorAll("[data-countup-target]");
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          values.forEach((node) => {
            if (!(node instanceof HTMLElement)) return;
            if (node.dataset.countupComplete === "true") return;

            const target = Number(node.dataset.countupTarget || "0");
            const suffix = node.dataset.countupSuffix || "";
            const duration = 1400;
            const startTime = performance.now();

            const step = (currentTime) => {
              const elapsed = currentTime - startTime;
              const progress = Math.min(elapsed / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              const value = Math.round(target * eased);
              node.textContent = `${value}${suffix}`;

              if (progress < 1) {
                requestAnimationFrame(step);
                return;
              }

              node.textContent = `${target}${suffix}`;
              node.dataset.countupComplete = "true";
            };

            requestAnimationFrame(step);
          });

          observer.disconnect();
        });
      },
      { threshold: 0.35 }
    );

    observer.observe(group);
  });
</script>