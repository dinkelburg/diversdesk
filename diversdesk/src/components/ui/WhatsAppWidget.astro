---
import { WHATSAPP_CONTACT } from "@data/contact";
---

<a
  class="whatsapp-widget"
  href={WHATSAPP_CONTACT.href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with DiversDesk on WhatsApp (opens in a new tab)"
>
  <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true">
    <path d="M20.52 3.48A11.91 11.91 0 0 0 12.04 0C5.46 0 .1 5.35.1 11.94c0 2.1.55 4.15 1.6 5.96L0 24l6.26-1.64a11.9 11.9 0 0 0 5.77 1.47h.01c6.58 0 11.94-5.35 11.94-11.94 0-3.19-1.24-6.18-3.46-8.41ZM12.04 21.8a9.9 9.9 0 0 1-5.05-1.38l-.36-.21-3.72.98.99-3.63-.24-.38a9.87 9.87 0 0 1-1.51-5.24c0-5.46 4.44-9.9 9.9-9.9a9.83 9.83 0 0 1 7 2.9 9.83 9.83 0 0 1 2.9 7c0 5.46-4.44 9.9-9.91 9.9Zm5.43-7.41c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.2 5.09 4.49.71.31 1.27.49 1.7.63.71.22 1.36.19 1.87.11.57-.08 1.77-.72 2.02-1.42.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35Z" />
  </svg>
  <span class="whatsapp-tooltip" aria-hidden="true">Chat on WhatsApp</span>
</a>

<style>
  .whatsapp-widget {
    position: fixed;
    right: calc(1rem + env(safe-area-inset-right, 0px));
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px) + var(--dd-cookie-banner-height, 0px));
    z-index: 50;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
    box-shadow: 0 4px 16px rgb(0 0 0 / 20%);
    transition: background-color 150ms ease, transform 150ms ease;
  }

  .whatsapp-widget:hover {
    background: #20bd5a;
    transform: translateY(-2px);
  }

  .whatsapp-widget:focus-visible {
    outline: 3px solid #075e54;
    outline-offset: 4px;
  }

  .whatsapp-widget svg {
    flex-shrink: 0;
  }

  .whatsapp-tooltip {
    position: absolute;
    right: calc(100% + 0.75rem);
    top: 50%;
    transform: translateY(-50%);
    padding: 0.625rem 0.875rem;
    border-radius: 0.5rem;
    background: #1f2937;
    color: #fff;
    white-space: nowrap;
    visibility: hidden;
    opacity: 0;
    transition: opacity 150ms ease;
  }

  /* Bridge the gap so the label stays visible when hovered. */
  .whatsapp-tooltip::after {
    content: "";
    position: absolute;
    left: 100%;
    top: 0;
    width: 0.75rem;
    height: 100%;
  }

  .whatsapp-widget:focus-visible .whatsapp-tooltip {
    visibility: visible;
    opacity: 1;
  }

  @media (hover: hover) {
    .whatsapp-widget:hover .whatsapp-tooltip {
      visibility: visible;
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-widget,
    .whatsapp-tooltip {
      transition: none;
    }
  }

  @media print {
    .whatsapp-widget {
      display: none;
    }
  }
</style>
