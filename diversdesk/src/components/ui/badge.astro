---
interface Props {
  color?: "DEFAULT" | "indigo" | "orange" | "purple";
  class?: string;
}

const props = Astro.props as Props;
const colorKey: keyof typeof colors = props.color ?? "DEFAULT";
const className = props.class;

const colors = {
  DEFAULT: "bg-gray-100 border-gray-200 border text-gray-800",
  indigo: "bg-indigo-100 border-indigo-200 border text-indigo-600",
  orange: "bg-orange-100 border-orange-200 border text-orange-600",
  purple: "bg-purple-100 border-purple-200 border text-purple-600",
};

const badgeClasses = colors[colorKey];
---

<span
  class:list={[
    badgeClasses,
    className,
    "rounded-full text-xs font-medium px-3 py-1 ",
  ]}>
  <slot />
</span>
