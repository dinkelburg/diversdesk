---
import StarlightPageTitle from '@astrojs/starlight/components/PageTitle.astro';
import { audienceHome, audienceLabels, docAudiences, resolveDocAudience } from '../../../lib/docs/audiences';
const audience = resolveDocAudience(Astro.url.pathname, Astro.locals.starlightRoute.entry.data.audiences);
---
<div class="audience-navigation" data-doc-audience={audience}>
  <a href={audienceHome(audience)}>{audienceLabels[audience]} help</a>
  <details>
    <summary>Change audience</summary>
    <nav aria-label="Help audience">
      {docAudiences.map((item) => <a href={audienceHome(item)} aria-current={item === audience ? 'true' : undefined}>{audienceLabels[item]}</a>)}
    </nav>
  </details>
</div>
<StarlightPageTitle />
<style>
  .audience-navigation { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; font-size: .85rem; flex-wrap: wrap; }
  details { position: relative; }
  summary { cursor: pointer; color: var(--sl-color-gray-2); }
  nav { position: absolute; right: 0; z-index: 5; min-width: 15rem; padding: .5rem; border: 1px solid var(--sl-color-gray-5); border-radius: .5rem; background: var(--sl-color-black); box-shadow: var(--sl-shadow-md); }
  nav a { display: block; padding: .65rem; text-decoration: none; }
  nav a[aria-current] { font-weight: bold; background: var(--sl-color-gray-6); }
</style>
