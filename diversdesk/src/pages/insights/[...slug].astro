---
// Import section components
import { SITE } from "@data/constants";
import MainLayout from "@/layouts/MainLayout.astro";
import { getCollection } from "astro:content";

// Use `getStaticPaths` to generate static routes for generated pages on build
export async function getStaticPaths() {
  const insightPosts = await getCollection("insights");
  return insightPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

// Get the props for this page that define a specific insight post
const { post } = Astro.props;

const { Content } = await post.render();

const pageTitle: string = `${post.data.title} | ${SITE.title}`;
const pageDescription: string = post.data.description;
const siteOrigin = "https://www.diversdesk.com";
const pageUrl = `${siteOrigin}/insights/${post.slug}/`;
const pageImage = new URL(post.data.cardImage.src, siteOrigin).toString();
const insightSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": pageTitle,
  "description": pageDescription,
  "url": pageUrl,
  "primaryImageOfPage": {
    "@type": "ImageObject",
    "url": pageImage,
  },
  "isPartOf": {
    "@type": "WebSite",
    "url": siteOrigin,
    "name": "DiversDesk",
  },
};
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  image={pageImage}
  canonical={pageUrl}
  ogType="article"
  structuredData={insightSchema}
  robots={post.data.robots}
>
  <section class="py-6 sm:py-8 lg:py-12">
    <div class="mx-auto max-w-screen-xl px-4 md:px-8">
      <div class="grid gap-8 md:grid-cols-2 lg:gap-12">
        <div>
          <div
            id="progress-mobile"
            class="fixed left-0 top-0 h-2 w-full bg-gradient-to-r from-orange-400/30 to-orange-400 md:hidden"
          >
          </div>
          <div id="insight-sidebar" class="flex flex-col gap-10">
            <div
              id="insight-cover"
              class="h-64 overflow-hidden rounded-lg shadow-lg md:h-auto"
            >
              <img
                class="h-full w-full object-cover object-center"
                src={post.data.cardImage.src}
                alt={post.data.cardImageAlt}
                draggable="false"
                loading="eager"
                decoding="async"
              />
            </div>
            <div id="pin" class="hidden md:block">
              <div id="insight-toc-content" class="space-y-4">
                <div
                  class="h-1 w-full overflow-hidden bg-neutral-300 dark:bg-neutral-700"
                >
                  <div
                    id="progress"
                    class="h-full w-full bg-gradient-to-r from-orange-400/30 to-orange-400"
                  >
                  </div>
                </div>
                <p class="text-pretty text-sm font-light text-neutral-500">
                  Table of Contents:
                </p>
                <div id="toc">
                  <ul
                    class="space-y-2 text-pretty text-base text-neutral-700 transition duration-300 dark:text-neutral-400"
                  >
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="md:pt-8">
          <h1
            class="mb-4 text-balance text-center text-2xl font-bold text-neutral-800 dark:text-neutral-200 sm:text-3xl md:mb-6 md:text-left"
          >
            {post.data.title}
          </h1>

          <article
            class="text-pretty text-lg text-neutral-700 dark:text-neutral-300"
          >
            <Content />
          </article>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style is:global>
  :root {
    --transition-cubic: cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  html {
    scroll-behavior: smooth;
  }

  article h2,
  article h3,
  article h4,
  article h5,
  article h6 {
    font-weight: bold;
    margin-top: 2.5rem;
    scroll-margin-top: 3rem;
  }

  h2 {
    font-size: 1.5rem;
    line-height: 2rem;
  }

  h3 {
    font-size: 1.25rem;
    line-height: 1.75rem;
  }

  h4 {
    font-size: 1.125rem;
    line-height: 1.75rem;
  }

  p {
    margin-top: 1.5rem;
  }

  article ul,
  article ol {
    margin-top: 0.75rem;
    padding-left: 1.5rem;
    list-style-position: outside;
  }

  article ul {
    list-style-type: disc;
  }

  article ol {
    list-style-type: decimal;
  }

  article li + li {
    margin-top: 0.5rem;
  }

  #toc li {
    display: flex;
    align-items: center;
    opacity: 0.8;
    transition: all 300ms var(--transition-cubic);
  }

  #toc li.selected {
    opacity: 1;
  }

  #toc li svg {
    width: 0;
    height: 0;
    transition:
      height 400ms var(--transition-cubic),
      width 400ms var(--transition-cubic);
  }

  #toc li.selected svg {
    width: 1.25rem;
    height: 1.25rem;
    margin-right: 0.3rem;
  }
</style>

<script>
  const onScroll = (): void => {
    const article = document.querySelector("article");
    if (!article) return;

    const articleHeight = article.offsetHeight;
    const articleOffsetTop =
      article.getBoundingClientRect().top + window.scrollY;

    const scrollTop = window.scrollY || document.documentElement.scrollTop;

    if (articleHeight) {
      const maxScrollable = Math.max(1, articleHeight - window.innerHeight);
      const rawProgress = ((scrollTop - articleOffsetTop) / maxScrollable) * 100;
      const progress = Math.min(100, Math.max(0, rawProgress));

      const progressBar = document.getElementById("progress");
      const progressBarMobile = document.getElementById("progress-mobile");

      if (progressBar && progressBarMobile) {
        progressBar.style.width = `${progress}%`;
        progressBarMobile.style.width = `${progress}%`;
      }
    }
  };

  const initProgress = (): void => {
    window.removeEventListener("scroll", onScroll);
    window.addEventListener("scroll", onScroll, { passive: true });

    const progressBar = document.getElementById("progress");
    const progressBarMobile = document.getElementById("progress-mobile");

    if (progressBar && progressBarMobile) {
      progressBar.style.width = "0%";
      progressBarMobile.style.width = "0%";
    }

    onScroll();
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initProgress, { once: true });
  } else {
    initProgress();
  }

  document.addEventListener("astro:page-load", initProgress);
</script>
<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let stopSidebarPin: (() => void) | undefined;
  const tocScrollTriggers: ScrollTrigger[] = [];

  const SVG_HTML_STRING =
    '<svg class="w-0 h-0 flex-none" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="#fa5a15"><path stroke-linecap="round" stroke-linejoin="round" d="m12.75 15 3-3m0 0-3-3m3 3h-7.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></svg>';

  function setActiveLinkById(id: string | null) {
    const listItems = document.querySelectorAll("#toc li");
    listItems.forEach((item) => item.classList.remove("selected"));

    if (!id) return;

    const activeLink = document.querySelector(`#toc a[href="#${id}"]`);

    if (!activeLink) return;

    const listItem = activeLink.parentElement;
    listItem?.classList.add("selected");
  }

  function initSidebarPin(): void {
    const sidebar = document.getElementById("insight-sidebar");
    const cover = document.getElementById("insight-cover");
    const tocPanel = document.getElementById("pin");
    const tocContent = document.getElementById("insight-toc-content");
    const navbar = document.querySelector("header");
    if (!sidebar || !cover || !tocPanel || !tocContent) return;

    const viewportPadding = 16;
    const getPinTop = () => {
      const navbarTop = navbar ? parseFloat(getComputedStyle(navbar).top) || 0 : 0;
      return navbarTop + (navbar?.offsetHeight ?? 0) + viewportPadding;
    };
    // Measure the contents directly so GSAP's pin spacer doesn't affect the fit check.
    const getSidebarHeight = () =>
      cover.offsetHeight + parseFloat(getComputedStyle(sidebar).rowGap) + tocContent.offsetHeight;

    let pin: ScrollTrigger | undefined;
    let frame = 0;
    let previousLayout = "";

    const updatePin = () => {
      const top = getPinTop();
      const sidebarHeight = getSidebarHeight();
      const desktop = getComputedStyle(tocPanel).display !== "none";
      const fits = sidebarHeight <= window.innerHeight - top - viewportPadding;
      const layout = [desktop, fits, sidebarHeight, sidebar.offsetWidth, window.innerHeight, top].join();
      if (layout === previousLayout) return;
      previousLayout = layout;

      const target = desktop ? (fits ? sidebar : tocPanel) : undefined;
      if (pin?.pin !== target) {
        pin?.kill();
        pin = target ? ScrollTrigger.create({
          trigger: target,
          pin: true,
          pinSpacing: target === tocPanel,
          start: fits ? () => `top ${getPinTop()}px` : "top 20%",
          endTrigger: "footer",
          end: fits
            ? () => `top ${getPinTop() + getSidebarHeight() + viewportPadding}px`
            : "top bottom",
        }) : undefined;
      }
      ScrollTrigger.refresh();
    };

    const scheduleUpdate = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(updatePin);
    };
    const observer = new ResizeObserver(scheduleUpdate);
    observer.observe(cover);
    observer.observe(tocContent);
    if (navbar) observer.observe(navbar);
    window.addEventListener("resize", scheduleUpdate);
    stopSidebarPin = () => {
      cancelAnimationFrame(frame);
      observer.disconnect();
      window.removeEventListener("resize", scheduleUpdate);
      pin?.kill();
    };
    updatePin();
  }

  function initToc(): void {
    stopSidebarPin?.();
    stopSidebarPin = undefined;
    tocScrollTriggers.forEach((trigger) => trigger.kill());
    tocScrollTriggers.length = 0;

    // The article element that contains the Markdown content
    const article: HTMLElement | null = document.querySelector("article");
    // The ToC container <ul> element
    const tocList: HTMLElement | null = document.querySelector("#toc ul");
    if (!tocList) return;

    tocList.innerHTML = "";

    const headings: NodeListOf<HTMLElement> | [] = article
      ? article.querySelectorAll("h1, h2, h3, h4, h5, h6")
      : [];

    headings.forEach((heading, i) => {
      if (heading instanceof HTMLElement) {
        const listItem = document.createElement("li");
        listItem.className = "toc-level-" + heading.tagName.toLowerCase();

        const tempDiv = document.createElement("div");
        tempDiv.innerHTML = SVG_HTML_STRING;

        const svg = tempDiv.firstChild;
        listItem.appendChild(svg as Node);

        const link = document.createElement("a");
        link.href = "#" + heading.id;
        link.textContent = heading.textContent;
        listItem.appendChild(link);

        tocList?.appendChild(listItem);

        const timeline = gsap.timeline({
          scrollTrigger: {
            trigger: heading,
            start: "top 20%",
            end: () =>
              `bottom top+=${i === headings.length - 1 ? 0 : (headings[i + 1] as HTMLElement).getBoundingClientRect().height}`,
            onEnter: () => setActiveLinkById(heading.id),
            onLeaveBack: () =>
              setActiveLinkById((headings[i - 1] as HTMLElement)?.id),
          },
        });

        if (timeline.scrollTrigger) {
          tocScrollTriggers.push(timeline.scrollTrigger);
        }
      }
    });

    initSidebarPin();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initToc, { once: true });
  } else {
    initToc();
  }

  document.addEventListener("astro:page-load", initToc);
  document.addEventListener("astro:before-swap", () => stopSidebarPin?.());
</script>
