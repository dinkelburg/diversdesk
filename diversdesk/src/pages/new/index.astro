---
import { Image } from "astro:assets";
import CompanyLogos from "@components/CompanyLogos.astro";
import FAQ from "@components/sections/FAQ.astro";
import FaqSchema from "@components/sections/new-landing/FaqSchema.astro";
import StatsBand from "@components/sections/new-landing/StatsBand.astro";
import TestimonialsSectionMin from "@/components/sections/testimonials/TestimonialsSectionMinimal.astro";
import PreviewLandingLayout from "@/layouts/PreviewLandingLayout.astro";
import {
  featureMap,
  homepageFaqs,
  homepageStats,
  homeHeroImage,
  mainPageTestimonials,
  solutions,
} from "@data/newLanding";

const featuredFeatures = [
  featureMap["digital-onboarding"],
  featureMap["planner-scheduling"],
  featureMap["booking-engine-channel-manager"],
  featureMap["inventory-pos-rentals"],
  featureMap["finance-bookkeeping"],
  featureMap["agents-partners-portal"],
];

const homepageFaqGroup = {
  subTitle: "Each page in this preview route is hidden from search while the new landing system is built in parallel.",
  faqs: homepageFaqs,
};
---

<PreviewLandingLayout
  title="DiversDesk Preview | Dive Business Management Software"
  description="Preview the next DiversDesk landing experience for dive centers, resorts, and liveaboards."
  canonical="https://www.diversdesk.com/new"
>
  <FaqSchema faqs={homepageFaqs} />

  <section class="landing-section pb-8 pt-12 lg:pb-12 lg:pt-16">
    <div class="landing-shell">
      <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
        <div>
          <span class="landing-tag">Preview Homepage</span>
          <h1 class="landing-display mt-6 max-w-4xl text-5xl text-slate-950 sm:text-6xl lg:text-7xl">
            Dive business management software for operators who want more clarity and less admin.
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600 sm:text-xl">
            DiversDesk brings bookings, onboarding, planning, payments, retail, and guest operations into one calm operating system for dive centers, dive resorts, and liveaboards.
          </p>
          <ul class="landing-bullet-list mt-8 grid gap-3 text-sm font-medium text-slate-700 sm:grid-cols-2 sm:text-base">
            <li>Stop stitching together spreadsheets, booking tools, waivers, POS, and finance workflows.</li>
            <li>Give staff one source of truth for guests, schedules, inventory, and revenue events.</li>
            <li>Move customers from inquiry to arrival with fewer delays, errors, and manual handoffs.</li>
            <li>Build a more professional guest experience without creating more back-office work.</li>
          </ul>
          <div class="mt-10 flex flex-wrap gap-4">
            <a class="landing-button-primary" href="https://calendly.com/diversdesk-info/demo">Book a demo</a>
            <a class="landing-button-secondary" href="/new/features">Explore all features</a>
          </div>
        </div>

        <div class="landing-panel overflow-hidden rounded-[36px] p-4 sm:p-6">
          <div class="rounded-[28px] bg-slate-950 p-6 text-white sm:p-8">
            <div class="flex flex-wrap gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-orange-200">
              <span>Bookings</span>
              <span>Operations</span>
              <span>Payments</span>
              <span>Guests</span>
            </div>
            <h2 class="landing-display mt-5 text-3xl sm:text-4xl">
              Three focused solution paths. One connected product story.
            </h2>
            <p class="mt-4 max-w-xl text-sm leading-7 text-slate-300 sm:text-base">
              Start with the business model you run today, then drill into the features that remove friction from sales, guest preparation, daily operations, and financial follow-through.
            </p>
          </div>
          <div class="mt-4 rounded-[28px] bg-white p-4 sm:p-5">
            <Image
              src={homeHeroImage}
              alt="DiversDesk shown across laptop and mobile screens."
              class="w-full rounded-[22px] object-cover"
              widths={[480, 720, 960, 1280]}
              sizes="(max-width: 1023px) 100vw, 48vw"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <StatsBand
    title="The new landing system is built around measurable outcomes."
    intro="These proof-style numbers are meant to reinforce the promise of speed, clarity, and consolidation across every solution page."
    stats={homepageStats}
  />

  <section class="landing-section py-10 lg:py-14">
    <div class="landing-shell">
      <div class="mb-8 max-w-3xl">
        <span class="landing-tag">Solutions</span>
        <h2 class="landing-display mt-5 text-4xl text-slate-950 sm:text-5xl">
          One brand. Three operating models. No generic messaging.
        </h2>
        <p class="mt-4 text-lg leading-8 text-slate-600">
          Each route speaks to a distinct business model while staying grounded in the same core promise: less admin, fewer errors, and a more professional customer experience.
        </p>
      </div>

      <div class="grid gap-6 xl:grid-cols-3">
        {solutions.map((solution) => (
          <article class="landing-card rounded-[30px] p-6 sm:p-7">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-orange-600">{solution.shortLabel}</p>
            <h3 class="landing-display mt-4 text-3xl text-slate-950">{solution.label}</h3>
            <p class="mt-4 text-base leading-7 text-slate-600">{solution.heroIntro}</p>
            <ul class="landing-bullet-list mt-6 space-y-3 text-sm leading-6 text-slate-700">
              {solution.valueProps.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <div class="mt-8 flex flex-wrap gap-3">
              <a class="landing-button-primary" href={`/new/solutions/${solution.slug}`}>Explore solution</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CompanyLogos
    title="Trusted by operators who want less admin and more control"
    subTitle="The moving operator logos stay on the combined landing page to strengthen social proof without repeating the same section across every child page."
  />

  <section class="landing-section py-12 lg:py-16">
    <div class="landing-shell">
      <div class="mb-8 flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-3xl">
          <span class="landing-tag">Feature preview</span>
          <h2 class="landing-display mt-5 text-4xl text-slate-950 sm:text-5xl">
            The new feature story is structured around real operational pressure.
          </h2>
        </div>
        <a class="landing-button-secondary" href="/new/features">Show all features</a>
      </div>

      <div class="grid gap-6 lg:grid-cols-2 xl:grid-cols-3">
        {featuredFeatures.map((feature) => (
          <article class="landing-card rounded-[30px] p-6 sm:p-7">
            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-500">{feature.eyebrow}</p>
            <h3 class="landing-display mt-3 text-3xl text-slate-950">{feature.title}</h3>
            <p class="mt-4 text-base leading-7 text-slate-600">{feature.summary}</p>
            <ul class="landing-bullet-list mt-6 space-y-3 text-sm leading-6 text-slate-700">
              {feature.bullets.slice(0, 2).map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <div class="mt-8 flex items-center justify-between gap-4">
              <div class="flex flex-wrap gap-2">
                {feature.appliesTo.map((solutionSlug) => (
                  <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-slate-600">
                    {solutionSlug.replace("-", " ")}
                  </span>
                ))}
              </div>
              <a class="text-sm font-semibold text-orange-600" href={`/new/features/${feature.slug}`}>View feature</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <TestimonialsSectionMin
    title="What operators already say about DiversDesk"
    testimonials={mainPageTestimonials}
    primaryBtn="Read more about DiversDesk"
    primaryBtnURL="/about"
  />

  <div class="landing-divider mx-auto mt-4 max-w-[1400px]"></div>

  <FAQ title="Questions teams ask before they consolidate" faqs={homepageFaqGroup} />
</PreviewLandingLayout>