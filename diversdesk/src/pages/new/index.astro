---
import { Image } from "astro:assets";
import CompanyLogos from "@components/CompanyLogos.astro";
import FAQ from "@components/sections/FAQ.astro";
import FaqSchema from "@components/sections/new-landing/FaqSchema.astro";
import StatsBand from "@components/sections/new-landing/StatsBand.astro";
import TestimonialsSectionMin from "@/components/sections/testimonials/TestimonialsSectionMinimal.astro";
import PreviewLandingLayout from "@/layouts/PreviewLandingLayout.astro";
import plannerImage from "@images/iPad_pro_detailed_day.avif";
import resortImage from "@images/insights/diversdesk-accommodation-mockup.avif";
import liveaboardImage from "@images/insights/liveaboard-ship.avif";
import {
  homepageFaqs,
  homepageStats,
  homeHeroImage,
  mainPageTestimonials,
  solutions,
} from "@data/newLanding";

const solutionPreviewImages = {
  "dive-centers": plannerImage,
  "dive-resorts": resortImage,
  liveaboards: liveaboardImage,
};

const homepageFaqGroup = {
  subTitle: "Learn how DiversDesk connects your guest journey and daily operations.",
  faqs: homepageFaqs,
};

const homepageAdvantages = [
  {
    title: "Less admin. More time for guests.",
    text: "Collect registration details and waivers before arrival, with guest information connected to the booking.",
  },
  {
    title: "A clearer view of your operation.",
    text: "Keep bookings, guests, and resources organized so your team can coordinate the day.",
  },
  {
    title: "An easier path from booking to payment.",
    text: "Let customers book online and complete their payment steps, with records your team can follow.",
  },
];
---

<PreviewLandingLayout
  title="DiversDesk Preview | Dive Business Management Software"
  description="Manage bookings, guest onboarding, planning, and payments for dive centers, resorts, and liveaboards with DiversDesk."
  canonical="https://www.diversdesk.com/new"
>
  <FaqSchema faqs={homepageFaqs} />

  <section class="landing-section pb-10 pt-10 lg:pb-16 lg:pt-16">
    <div class="landing-shell">
      <div class="grid gap-12 lg:grid-cols-[0.98fr_1.02fr] lg:items-center">
        <div>
          <span class="landing-tag">DiversDesk Solutions</span>
          <h1 class="landing-display mt-6 max-w-4xl text-5xl text-slate-950 sm:text-6xl lg:text-[4.8rem] lg:leading-[1.02]">
            One connected platform for dive centers, resorts, and liveaboards.
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600 sm:text-xl">
            DiversDesk gives dive businesses one professional operating system for bookings, onboarding, planning, payments, inventory, and guest operations, with a tailored path for each business model.
          </p>
          <div class="mt-9 flex flex-wrap gap-4">
            <a class="landing-button-primary" href="https://calendly.com/diversdesk-info/demo">Book a demo</a>
            <a class="landing-button-secondary" href="#solutions">See solutions</a>
          </div>
        </div>

        <div class="landing-hero-visual rounded-[32px]">
          <Image
            src={homeHeroImage}
            alt="DiversDesk shown across laptop and mobile screens."
            class="w-full rounded-[24px] object-cover"
            widths={[480, 720, 960, 1280]}
            sizes="(max-width: 1023px) 100vw, 48vw"
          />
        </div>
      </div>
    </div>
  </section>

  <section id="advantages" class="landing-section scroll-mt-28 py-10 lg:py-16" aria-label="Three advantages of DiversDesk">
    <div class="landing-shell">
      <div class="grid gap-8 border-y border-slate-200 py-10 lg:grid-cols-3 lg:gap-12 lg:py-12">
        {homepageAdvantages.map((advantage, index) => (
          <div>
            <span class="text-sm font-bold tracking-widest text-orange-700" aria-hidden="true">0{index + 1}</span>
            <h2 class="landing-display mt-4 max-w-sm text-3xl text-slate-950">{advantage.title}</h2>
            <p class="mt-4 max-w-md text-base leading-7 text-slate-600">{advantage.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="solutions" class="landing-section py-10 lg:py-16">
    <div class="landing-shell">
      <div class="mx-auto max-w-3xl text-center">
        <span class="landing-tag">Choose your operation</span>
        <h2 class="landing-display mt-5 text-4xl text-slate-950 sm:text-5xl lg:text-6xl">
          Start with the business model you run.
        </h2>
        <p class="mt-4 text-lg leading-8 text-slate-600">
          From daily dive trips to resort stays and liveaboard departures, explore the workflows that fit your guests, your team, and your operation.
        </p>
      </div>

      <div class="mt-12 grid gap-6 xl:grid-cols-3">
        {solutions.map((solution) => (
          <article class="landing-card overflow-hidden rounded-[30px]">
            <Image
              src={solutionPreviewImages[solution.slug]}
              alt={`${solution.shortLabel} operations with DiversDesk`}
              class="aspect-[16/10] w-full object-cover"
              widths={[480, 720, 960]}
              sizes="(max-width: 1279px) 100vw, 30vw"
            />
            <div class="p-6 sm:p-7">
              <p class="landing-kicker">{solution.shortLabel}</p>
              <h3 class="landing-display mt-3 text-3xl text-slate-950">{solution.label}</h3>
              <p class="mt-4 text-base leading-7 text-slate-600">{solution.heroIntro}</p>
              <div class="mt-6 space-y-2">
                {solution.valueProps.slice(0, 2).map((item) => (
                  <p class="text-sm font-medium leading-6 text-slate-700">{item}</p>
                ))}
              </div>
              <div class="mt-8 flex flex-wrap gap-3">
                <a class="landing-button-primary" href={`/new/solutions/${solution.slug}`}>Explore {solution.shortLabel}</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <StatsBand
    title="Keep guest preparation and operations connected."
    intro="Bring registration, bookings, and guest information into the same workflow."
    stats={homepageStats}
  />

  <section class="landing-section py-12 lg:py-20">
    <div class="landing-shell">
      <div class="mx-auto max-w-3xl text-center">
        <span class="landing-tag">See your operation clearly</span>
        <h2 class="landing-display mt-5 text-4xl text-slate-950 sm:text-5xl lg:text-6xl">
          A shared view of your day, your stays, and your departures.
        </h2>
        <p class="mt-5 text-lg leading-8 text-slate-600">
          Give staff the information they need to coordinate guests and resources, from the dive planner to accommodation and liveaboard bookings.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-[1.2fr_0.8fr]">
        <div class="landing-image-frame rounded-[30px]">
          <Image
            src={plannerImage}
            alt="DiversDesk daily planner showing dive operations."
            class="aspect-[16/10] h-full w-full rounded-[24px] object-cover"
            widths={[720, 960, 1280]}
            sizes="(max-width: 1023px) 100vw, 58vw"
          />
        </div>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-1">
          <div class="landing-image-frame rounded-[30px]">
            <Image
              src={resortImage}
              alt="DiversDesk accommodation management."
              class="aspect-[4/3] w-full rounded-[24px] object-cover"
              widths={[480, 720, 960]}
              sizes="(max-width: 639px) 100vw, 24vw"
            />
          </div>
          <div class="landing-image-frame rounded-[30px]">
            <Image
              src={liveaboardImage}
              alt="A liveaboard vessel at sea."
              class="aspect-[4/3] w-full rounded-[24px] object-cover"
              widths={[480, 720, 960]}
              sizes="(max-width: 639px) 100vw, 24vw"
            />
          </div>
        </div>
      </div>

      <div class="landing-proof-list mx-auto mt-8 grid max-w-6xl gap-3 text-sm font-medium leading-7 text-slate-700 md:grid-cols-2">
        <p>Coordinate activity schedules and guest bookings without rebuilding the same information in separate spreadsheets.</p>
        <p>Choose the tools that fit your operation, with a connected booking and guest record at the center.</p>
      </div>
    </div>
  </section>

  <CompanyLogos
    title="Trusted by operators who want less admin and more control"
    subTitle="Meet some of the dive businesses using DiversDesk."
  />

  <section class="landing-section py-12 lg:py-20">
    <div class="landing-shell">
      <div class="landing-card grid gap-8 overflow-hidden rounded-[32px] p-4 lg:grid-cols-[0.92fr_1.08fr] lg:items-center lg:p-6">
        <div class="order-2 lg:order-1">
          <Image
            src={plannerImage}
            alt="DiversDesk planner with daily trip and guest information."
            class="aspect-[5/4] w-full rounded-[26px] object-cover"
            widths={[720, 960, 1280]}
            sizes="(max-width: 1023px) 100vw, 46vw"
          />
        </div>
        <div class="order-1 px-2 py-4 sm:px-4 lg:order-2 lg:px-8">
          <span class="landing-tag">Explore the features</span>
          <h2 class="landing-display mt-5 text-4xl text-slate-950 sm:text-5xl lg:text-6xl">
            The right tools for each part of your day.
          </h2>
          <p class="mt-5 text-lg leading-8 text-slate-600">
            Explore bookings, onboarding, scheduling, payments, and more. See how each feature works and how your team can use it.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a class="landing-button-primary" href="/new/features">Browse all features</a>
            <a class="landing-button-secondary" href="/new/solutions/dive-centers">Start with Dive Centers</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <TestimonialsSectionMin
    title="What operators already say about DiversDesk"
    testimonials={mainPageTestimonials}
    primaryBtn="Read more about DiversDesk"
    primaryBtnURL="/about"
  />

  <div class="landing-divider mx-auto mt-4 max-w-[1400px]"></div>

  <FAQ title="Questions teams ask before they consolidate" faqs={homepageFaqGroup} />
</PreviewLandingLayout>
