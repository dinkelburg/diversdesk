---
import { Image } from "astro:assets";
import FAQ from "@components/sections/FAQ.astro";
import FaqSchema from "@components/sections/new-landing/FaqSchema.astro";
import StatsBand from "@components/sections/new-landing/StatsBand.astro";
import PreviewLandingLayout from "@/layouts/PreviewLandingLayout.astro";
import { featureMap, solutions, type SolutionPage } from "@data/newLanding";

export function getStaticPaths() {
  return solutions.map((solution) => ({
    params: { slug: solution.slug },
    props: { solution },
  }));
}

const { solution } = Astro.props as { solution: SolutionPage };
const solutionFeatures = solution.featureSlugs.map((slug) => featureMap[slug]).filter(Boolean);
const spotlightFeatures = solutionFeatures.slice(0, 2);
const siblingSolutions = solutions.filter((item) => item.slug !== solution.slug);

const faqGroup = {
  subTitle: "Every solution page in the preview route now has its own FAQ block for topical relevance and future launch-ready SEO coverage.",
  faqs: solution.faqs,
};
---

<PreviewLandingLayout
  title={solution.metaTitle}
  description={solution.metaDescription}
  canonical={`https://www.diversdesk.com/new/solutions/${solution.slug}`}
>
  <FaqSchema faqs={solution.faqs} />

  <section class="landing-section pb-10 pt-8 lg:pb-16 lg:pt-12">
    <div class="landing-shell">
      <div class="mb-8 flex flex-wrap gap-3">
        <a class={`rounded-full px-4 py-2 text-sm font-semibold ${Astro.params.slug === solution.slug ? "bg-orange-50 text-orange-700" : "bg-slate-100 text-slate-700"}`} href={`/new/solutions/${solution.slug}`}>
          {solution.shortLabel}
        </a>
        {siblingSolutions.map((item) => (
          <a class="rounded-full bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-orange-50 hover:text-orange-700" href={`/new/solutions/${item.slug}`}>
            {item.shortLabel}
          </a>
        ))}
      </div>

      <div class="grid gap-12 lg:grid-cols-[0.94fr_1.06fr] lg:items-center">
        <div>
          <span class="landing-tag">{solution.heroEyebrow}</span>
          <h1 class="landing-display mt-6 max-w-4xl text-5xl text-slate-950 sm:text-6xl lg:text-[4.6rem] lg:leading-[1.02]">
            {solution.heroTitle}
          </h1>
          <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600 sm:text-xl">
            {solution.heroIntro}
          </p>
          <ul class="landing-bullet-list mt-8 space-y-3 text-sm leading-7 text-slate-700 sm:text-base">
            {solution.valueProps.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <div class="mt-10 flex flex-wrap gap-4">
            <a class="landing-button-primary" href="https://calendly.com/diversdesk-info/demo">Book a demo</a>
            <a class="landing-button-secondary" href={`/new/solutions/${solution.slug}/features`}>Explore {solution.shortLabel} features</a>
          </div>
        </div>

        <div class="space-y-5">
          <div class="landing-image-frame rounded-[34px]">
            <Image
              src={spotlightFeatures[0].image}
              alt={spotlightFeatures[0].imageAlt}
              class="aspect-[5/4] w-full rounded-[26px] object-cover"
              widths={[720, 960, 1280]}
              sizes="(max-width: 1023px) 100vw, 48vw"
            />
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            {solution.pains.map((item) => (
              <article class="landing-card rounded-[28px] p-5 sm:p-6">
                <p class="landing-kicker">Why it matters</p>
                <h2 class="landing-display mt-3 text-3xl text-slate-950">{item.title}</h2>
                <p class="mt-3 text-sm leading-7 text-slate-600">{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <StatsBand
    title={`Why ${solution.shortLabel.toLowerCase()} teams pay attention to these metrics`}
    intro="The goal is not more software. The goal is a more reliable operating rhythm across sales, service, and financial follow-through."
    stats={solution.stats}
  />

  <section class="landing-section py-10 lg:py-16">
    <div class="landing-shell">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div>
          <span class="landing-tag">Tailored feature menu</span>
          <h2 class="landing-display mt-5 text-4xl text-slate-950 sm:text-5xl lg:text-6xl">
            Feature priority changes by solution.
          </h2>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">
            The solution page should lead with the features that matter most for this business model, while still linking to the wider feature hub for deeper exploration and SEO coverage.
          </p>
          <div class="mt-8 space-y-3">
            {solutionFeatures.slice(0, 6).map((feature) => (
              <a class="flex items-center justify-between rounded-[20px] border border-slate-200 bg-white px-5 py-4 transition hover:border-orange-200 hover:bg-orange-50" href={`/new/solutions/${solution.slug}/features/${feature.slug}`}>
                <span class="text-base font-semibold text-slate-900">{feature.title}</span>
                <span class="text-sm font-semibold text-orange-700">View</span>
              </a>
            ))}
          </div>
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          {solutionFeatures.slice(0, 4).map((feature) => (
            <article class="landing-card rounded-[28px] p-6">
              <p class="landing-kicker">{feature.eyebrow}</p>
              <h3 class="landing-display mt-3 text-3xl text-slate-950">{feature.title}</h3>
              <p class="mt-4 text-sm leading-7 text-slate-600">{feature.summary}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="landing-section py-6 lg:py-12">
    <div class="landing-shell space-y-8">
      {spotlightFeatures.map((feature, index) => (
        <div class="grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-center">
          <div class={index % 2 === 0 ? "order-2 lg:order-1" : "order-2"}>
            <span class="landing-tag">Feature spotlight</span>
            <h2 class="landing-display mt-5 text-4xl text-slate-950 sm:text-5xl lg:text-6xl">{feature.title}</h2>
            <p class="mt-5 text-lg leading-8 text-slate-600">{feature.detail}</p>
            <ul class="landing-bullet-list mt-6 space-y-3 text-sm leading-7 text-slate-700">
              {feature.outcomes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <div class="mt-8">
              <a class="landing-button-secondary" href={`/new/solutions/${solution.slug}/features/${feature.slug}`}>See feature details</a>
            </div>
          </div>
          <div class={index % 2 === 0 ? "order-1 lg:order-2" : "order-1"}>
            <div class="landing-image-frame rounded-[34px]">
              <Image
                src={feature.image}
                alt={feature.imageAlt}
                class="aspect-[5/4] w-full rounded-[26px] object-cover"
                widths={[480, 720, 960, 1280]}
                sizes="(max-width: 1023px) 100vw, 48vw"
              />
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <FAQ title={`${solution.label} FAQ`} faqs={faqGroup} />

  <section class="landing-section pb-14 pt-6 lg:pb-20">
    <div class="landing-shell">
      <div class="landing-card-dark rounded-[36px] px-6 py-8 text-white sm:px-8 sm:py-10 lg:px-12">
        <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-orange-200">Next step</p>
            <h2 class="landing-display mt-4 text-4xl sm:text-5xl">{solution.ctaTitle}</h2>
            <p class="mt-4 max-w-3xl text-base leading-7 text-slate-200">{solution.ctaBody}</p>
          </div>
          <div class="flex flex-wrap gap-4">
            <a class="landing-button-primary" href="https://calendly.com/diversdesk-info/demo">Book a demo</a>
            <a class="landing-button-secondary !bg-white/10 !text-white !border-white/20" href="/signup-trial">Start free trial</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</PreviewLandingLayout>
