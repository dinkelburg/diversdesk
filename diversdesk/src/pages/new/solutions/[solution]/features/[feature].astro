---
import { Image } from "astro:assets";
import FAQ from "@components/sections/FAQ.astro";
import FaqSchema from "@components/sections/new-landing/FaqSchema.astro";
import PreviewLandingLayout from "@/layouts/PreviewLandingLayout.astro";
import { featureMap, solutions, type LandingFeature, type SolutionPage } from "@data/newLanding";

export function getStaticPaths() {
  return solutions.flatMap((solution) =>
    solution.featureSlugs
      .map((featureSlug) => featureMap[featureSlug])
      .filter(Boolean)
      .map((feature) => ({
        params: { solution: solution.slug, feature: feature.slug },
        props: { solution, feature },
      }))
  );
}

const { solution, feature } = Astro.props as { solution: SolutionPage; feature: LandingFeature };
const relatedFeatures = solution.featureSlugs
  .map((slug) => featureMap[slug])
  .filter((candidate) => candidate && candidate.slug !== feature.slug)
  .slice(0, 3);

const faqGroup = {
  subTitle: `This feature page is written in the context of ${solution.shortLabel.toLowerCase()}, so the next steps and related links stay focused.`,
  faqs: feature.faqs,
};

const featurePosition = solution.featureSlugs.indexOf(feature.slug) + 1;
const solutionReason = solution.valueProps[Math.max(0, Math.min(featurePosition - 1, solution.valueProps.length - 1))];
---

<PreviewLandingLayout
  title={`${feature.title} for ${solution.shortLabel} Preview | DiversDesk`}
  description={`${feature.summary} See how ${feature.title.toLowerCase()} supports ${solution.shortLabel.toLowerCase()} inside the DiversDesk operating system.`}
  canonical={`https://www.diversdesk.com/new/solutions/${solution.slug}/features/${feature.slug}`}
>
  <FaqSchema faqs={feature.faqs} />

  <section class="landing-section pb-8 pt-12 lg:pt-16">
    <div class="landing-shell">
      <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
        <div>
          <span class="landing-tag">{solution.shortLabel} feature</span>
          <h1 class="landing-display mt-6 max-w-4xl text-5xl text-slate-950 sm:text-6xl lg:text-7xl">
            {feature.title} for {solution.shortLabel.toLowerCase()}.
          </h1>
          <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600 sm:text-xl">
            {feature.detail} For {solution.shortLabel.toLowerCase()}, this supports a practical priority: {solutionReason.charAt(0).toLowerCase() + solutionReason.slice(1)}
          </p>
          <div class="mt-10 flex flex-wrap gap-4">
            <a class="landing-button-primary" href="https://calendly.com/diversdesk-info/demo">Book a demo</a>
            <a class="landing-button-secondary" href={`/new/solutions/${solution.slug}/features`}>Back to {solution.shortLabel} features</a>
          </div>
        </div>

        <div class="landing-panel rounded-[34px] p-4 sm:p-6">
          <Image
            src={feature.image}
            alt={feature.imageAlt}
            class="w-full rounded-[24px] object-cover"
            widths={[480, 720, 960, 1280]}
            sizes="(max-width: 1023px) 100vw, 46vw"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="landing-section py-10 lg:py-14">
    <div class="landing-shell">
      <div class="grid gap-6 lg:grid-cols-3">
        {feature.outcomes.map((outcome) => (
          <article class="landing-card rounded-[28px] p-6">
            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-orange-600">{solution.shortLabel} outcome</p>
            <h2 class="landing-display mt-3 text-3xl text-slate-950">{outcome}</h2>
            <p class="mt-4 text-sm leading-7 text-slate-600">
              This outcome supports the {solution.shortLabel.toLowerCase()} workflow by keeping the feature connected to the same customer, booking, and operating record.
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="landing-section py-4 lg:py-8">
    <div class="landing-shell">
      <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div class="landing-card-dark rounded-[32px] p-6 text-white sm:p-8">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-orange-200">What this changes for {solution.shortLabel}</p>
          <ul class="landing-bullet-list mt-6 space-y-4 text-sm leading-7 text-slate-200">
            {feature.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
        </div>

        <div class="landing-card rounded-[32px] p-6 sm:p-8">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Related {solution.shortLabel.toLowerCase()} features</p>
          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            {relatedFeatures.map((relatedFeature) => (
              <a class="rounded-[24px] border border-slate-200 bg-slate-50 p-5 transition hover:border-orange-200 hover:bg-orange-50" href={`/new/solutions/${solution.slug}/features/${relatedFeature.slug}`}>
                <h3 class="landing-display text-2xl text-slate-950">{relatedFeature.title}</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600">{relatedFeature.summary}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <FAQ title={`FAQ about ${feature.title} for ${solution.shortLabel.toLowerCase()}`} faqs={faqGroup} />
</PreviewLandingLayout>