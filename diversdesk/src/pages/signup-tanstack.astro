---
import SignupFormEmbed from "@/components/sections/SignupFormEmbed.astro";
import MainLayout from "@/layouts/MainLayout.astro";
---

<MainLayout
  title="TanStack signup form | Diversdesk"
  description="Request a Diversdesk trial using the new signup form."
  robots="noindex, nofollow"
>
  <section class="mx-auto min-h-[70vh] max-w-[56rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <SignupFormEmbed type="trial" />
  </section>
</MainLayout>
