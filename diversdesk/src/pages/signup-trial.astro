---
import SignupFormEmbed from "@/components/sections/SignupFormEmbed.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import { SITE } from "@data/constants";

const pageTitle = `Start Your 14-Day Free Trial | ${SITE.title}`;
---

<MainLayout
  title={pageTitle}
  description="Start your 14-day free trial of Diversdesk and launch faster scheduling, onboarding, and payments for your dive center."
  canonical="https://www.diversdesk.com/signup-trial"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://www.diversdesk.com/signup-trial",
    url: "https://www.diversdesk.com/signup-trial",
    name: "Start Your 14-Day Free Trial | Diversdesk",
    description: "Start your 14-day free trial of Diversdesk dive center management software.",
    isPartOf: {
      "@type": "WebSite",
      url: "https://www.diversdesk.com",
      name: "Diversdesk",
      description: "Diversdesk offers a state of the art Dive Center Management tool to meet all your operational needs.",
    },
    inLanguage: "en-US",
  }}
>
  <section class="mx-auto min-h-[70vh] max-w-[56rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <SignupFormEmbed type="trial" successUrl="/signup-trial-complete" />
  </section>
</MainLayout>
